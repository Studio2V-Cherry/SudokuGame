pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git 'https://github.com/Studio2V-Cherry/SudokuGame.git'
            }
        }

        stage('Restore Dependencies') {
            steps {
                bat 'dotnet restore'
            }
        }

        stage('Build') {
            steps {
                bat 'dotnet build --configuration Release'
            }
        }
    }
}
